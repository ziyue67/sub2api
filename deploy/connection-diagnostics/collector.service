[Unit]
Description=Sub2API edge connection metadata collector
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/sub2api-connection-collector.env
ExecStart=/usr/bin/python3 /opt/sub2api-connection-diagnostics/collect.py --log ${SUB2API_CONNECTION_LOG} --state ${SUB2API_CONNECTION_STATE} --node ${SUB2API_CONNECTION_NODE}
MemoryMax=96M
CPUQuota=10%
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sub2api-connection-collector
TimeoutStartSec=40
