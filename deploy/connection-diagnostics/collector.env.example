SUB2API_CONNECTION_ENDPOINT=http://127.0.0.1:4040/api/v1/admin/usage/connections/edge
# Inject the existing administrator API key through a root-owned 0600 env file.
SUB2API_CONNECTION_ADMIN_KEY=
SUB2API_CONNECTION_LOG=/var/log/caddy/sub2api-connections.jsonl
SUB2API_CONNECTION_STATE=/var/lib/sub2api-connection-collector/caddy.json
SUB2API_CONNECTION_NODE=primary-caddy
