# Insert inside each existing Sub2API site; keep existing handlers and routes.
# Never enable log_credentials. Drop all request/response headers at encoding.
log sub2api_connections {
    output file /var/log/caddy/sub2api-connections.jsonl {
        mode 0600
        roll_size 25MiB
        roll_keep 8
        roll_keep_for 168h
        roll_uncompressed
    }
    format filter {
        wrap json
        fields {
            request>headers delete
            resp_headers delete
            request>uri delete
            safe_path delete
        }
    }
}
# safe_path is emitted only for known public routes, never arbitrary capability URLs.
@connectionKnownPath path /v1/responses /v1/responses/compact /v1/chat/completions /v1/messages /v1/models /v1/embeddings /health /readyz
log_append @connectionKnownPath <public_path {http.request.uri.path}
log_append request_id {http.response.header.X-Request-ID}

@connectionCollector path /api/v1/admin/usage/connections/*
log_skip @connectionCollector
